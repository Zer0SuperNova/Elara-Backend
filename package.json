    "@smithy/node-http-handler": "^4.7.4",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "mysql2": "^3.22.3",
    "node-addon-api": "^8.7.0",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.12.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
